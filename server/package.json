{
  "name": "sunobro-backend",
  "version": "1.0.0",
  "description": "Sunobro e-commerce backend API (admin + storefront)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "node --watch server.js",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:seed": "sequelize db:seed:all",
    "test": "npm-run-all --silent test-lint test-mocha",
    "test-lint": "eslint controllers routes services database dto-schemas utils cron config test server.js",
    "test-mocha": "cross-env NODE_ENV=test nyc mocha --recursive --exit test"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^2.1.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "sequelize": "^6.37.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "chai-http": "^4.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "^2.29.1",
    "mocha": "^10.4.0",
    "npm-run-all": "^4.1.5",
    "nyc": "^15.1.0",
    "sequelize-cli": "^6.6.2",
    "sinon": "^17.0.1"
  }
}
