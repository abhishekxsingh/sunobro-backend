# Server
NODE_ENV=development
PORT=3000
DOMAIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MONGODB_URI=mongodb://localhost:27017/sunobro
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay (live) — never commit real secrets
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Optional: from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Storefront the API sends a shopper back to after PayU hosted checkout.
STOREFRONT_URL=http://localhost:3001

# PayU hosted checkout (test). PAYU_ENV=production uses https://secure.payu.in/_payment.
PAYU_MERCHANT_KEY=qfxxSS
PAYU_MERCHANT_SALT=q5qHRY7ZPbIeVWt2Btsjk8KikKE8gCHd
PAYU_ENV=test

# Cashfree sandbox. CASHFREE_ENV=production uses https://api.cashfree.com.
CASHFREE_APP_ID=0845b77ded81c665315a098741332eb3061041a53cfdc44ce7097d9ede73e6cc
CASHFREE_SECRET=31b1332b49394a90cc43828cc705bf1bd824f1adecc425ed5dff5a5e4e4bec0f
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# Email. SMTP is used when set; otherwise Resend.
RESEND_API_KEY=
FROM_EMAIL=SunoBro <orders@sunobro.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase Admin — verifies Google sign-in ID tokens.
# Service account: Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public web config, served to the storefront by GET /auth/firebase-config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Pinnacle SMS — login OTP. The API key stays in the environment, never in git.
SMS_SERVICE_URL=https://api.pinnacle.in/index.php/
SMS_SERVICE_API_KEY=
SMS_MESSAGE_TYPE=TXT
SMS_SENDER=GETPSA
# Principal entity. Same on every SMS.
SMS_DLT_ENTITY_ID=1701171628079680260
# Login OTP content template. Other messages use their own template id.
SMS_DLT_TEMPLATE_ID=1777179261336920608
