# Server
NODE_ENV=development
PORT=3000
DOMAIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MONGODB_URI=mongodb://localhost:27017/sunobro
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay (live) — never commit real secrets
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Optional: from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Storefront the API sends a shopper back to after PayU hosted checkout.
STOREFRONT_URL=http://localhost:3001

# PayU live hosted checkout (https://secure.payu.in/_payment).
# Dashboard webhooks (Developers → Webhooks). Same URL for Successful, Failed, Refund, and Dispute:
# https://<DOMAIN>/webhook/payu
PAYU_MERCHANT_KEY=ajSnyh
PAYU_MERCHANT_SALT=Eg2chVYGRCoUUayEGxwCIgZatcXoRTQE
PAYU_CLIENT_ID=0845b77ded81c665315a098741332eb3061041a53cfdc44ce7097d9ede73e6cc
PAYU_CLIENT_SECRET=31b1332b49394a90cc43828cc705bf1bd824f1adecc425ed5dff5a5e4e4bec0f

# Easebuzz hosted checkout. Leave blank until the merchant key and salt are ready.
# EASEBUZZ_ENV=test uses https://testpay.easebuzz.in.
EASEBUZZ_MERCHANT_KEY=
EASEBUZZ_MERCHANT_SALT=
EASEBUZZ_ENV=production

# Cashfree. Leave blank until Cashfree sends its own app id and secret.
# CASHFREE_ENV=production uses https://api.cashfree.com.
CASHFREE_APP_ID=
CASHFREE_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# Qikink Custom API (Integration → Custom API). Sandbox only when
# QIKINK_ENV=sandbox and NODE_ENV is not production.
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_ENV=live
# Dashboard asset folder id for product mockup URLs
# (…/clients/<id>/clientProducts/<qikinkProductId>/images/default.jpg).
# Not the same as QIKINK_CLIENT_ID. Leave blank to skip auto cover images.
# Dashboard My Products list (DataTables). Cron pulls new products from here.
# Custom API ClientId/Accesstoken are sent automatically. If Qikink redirects to
# sign-in, paste the Cookie header from a logged-in dashboard request:
# QIKINK_DASHBOARD_COOKIE=ci_session=...
# QIKINK_FETCH_MY_PRODUCTS_URL=https://dashboard.qikink.com/index.php/products/fetch_my_products
QIKINK_ASSET_CLIENT_ID=
# My Products CSV for first-time seed + cron (Qikink has no product-list API).
# Re-export from dashboard → Products → My Products when you add designs, save
# here (or host the file and set QIKINK_CATALOG_EXPORT_URL). Cron imports it.
QIKINK_CATALOG_EXPORT_PATH=exports/qikink-my-products.csv
# QIKINK_CATALOG_EXPORT_URL=
# 10000 = 10s for now; later 600000 (10 min) or 900000 (15 min). 0 disables.
QIKINK_CATALOG_SYNC_INTERVAL_MS=10000
QIKINK_CATALOG_AUTO_PUBLISH=true


# Email. SMTP is used when set; otherwise Resend.
RESEND_API_KEY=
FROM_EMAIL=SunoBro <orders@sunobro.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase Admin — verifies Google sign-in ID tokens.
# Service account: Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public web config, served to the storefront by GET /auth/firebase-config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
