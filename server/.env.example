# Server
NODE_ENV=development
PORT=3000
DOMAIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MONGODB_URI=mongodb://localhost:27017/sunobro
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay (live) — never commit real secrets
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Optional: from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Email. SMTP is used when set; otherwise Resend.
RESEND_API_KEY=
FROM_EMAIL=SunoBro <orders@sunobro.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Firebase Admin — verifies Google sign-in ID tokens.
# Service account: Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public web config, served to the storefront by GET /auth/firebase-config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
