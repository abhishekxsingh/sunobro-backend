# Server
NODE_ENV=development
PORT=4000
DOMAIN=http://localhost:4000
# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (Postgres)
DB_NAME=sunobro
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_COOKIE=sb_admin_session
CUSTOMER_SESSION_COOKIE=sb_session

# Cashfree (Payment Gateway)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Qikink (print-on-demand fulfillment)
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_ENV=sandbox
